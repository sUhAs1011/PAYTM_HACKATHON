SUPABASE_URL=
SUPABASE_SECRET_KEY=
PARCHA_DEMO_MERCHANT_ID=
# Enable only on a public demo deployment; keep the credentials in the host's secret manager.
PARCHA_DEMO_AUTH_ENABLED=false
PARCHA_DEMO_AUTH_USERNAME=
PARCHA_DEMO_AUTH_PASSWORD=
# Optional: explicit path to contracts/demo_bill_fixture.json (Docker mounts
# /contracts automatically; host runs resolve the repo-root copy).
PARCHA_FIXTURE_PATH=
GEMINI_API_KEY=
SARVAM_API_KEY=
# Voice localization; set target and TTS language together, and choose a
# speaker persona supported for that output language.
PARCHA_TRANSLATION_SOURCE_LANGUAGE=en-IN
PARCHA_TRANSLATION_TARGET_LANGUAGE=hi-IN
PARCHA_TTS_LANGUAGE=hi-IN
PARCHA_TTS_SPEAKER=aparna_hi_customer
